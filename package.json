{
  "name": "aalbor-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Production planning and stock control for Aalbor Kitchens",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "node dist/src/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "import:notion": "node dist/scripts/import-notion.js",
    "import:notion:dev": "tsx scripts/import-notion.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
